# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://nesil:CHANGE_ME@localhost:5432/nesilcoffee?schema=public"

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://nesilcoffee.com

# ---------------------------------------------------------------------------
# Admin auth
# ---------------------------------------------------------------------------
# No secret needed. Sessions are opaque 256-bit random tokens stored as SHA-256
# in the database, so there is nothing to sign and no key to rotate or leak.
# Create the first user with:
#   npm run admin:create -- --email you@example.com --name "Имя"

# ---------------------------------------------------------------------------
# Media uploads
# ---------------------------------------------------------------------------
# Absolute path OUTSIDE the git repo. nginx serves this directly at /uploads.
UPLOAD_DIR=/var/www/nesilcoffee/uploads

# ---------------------------------------------------------------------------
# Language detection by country
# ---------------------------------------------------------------------------
# Free MaxMind GeoLite2 key: https://www.maxmind.com/en/geolite2/signup
# Then run `npm run geoip:fetch` to download data/GeoLite2-Country.mmdb.
# Optional — without it, first-visit language falls back to Accept-Language.
MAXMIND_LICENSE_KEY=
# Override where the database lives. Defaults to ./data/GeoLite2-Country.mmdb.
# GEOIP_DB_PATH=/var/lib/geoip/GeoLite2-Country.mmdb

# ---------------------------------------------------------------------------
# Email notifications — Gmail SMTP
# ---------------------------------------------------------------------------
# SMTP_PASS is a Google App Password, which requires 2-step verification on
# the account: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=info@nesilcoffee.com
CONTACT_FROM_EMAIL="NesilCoffee <no-reply@nesilcoffee.com>"

# ---------------------------------------------------------------------------
# WhatsApp Cloud API — optional, off until Meta approves the message template
# ---------------------------------------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TO=
WHATSAPP_TEMPLATE=
