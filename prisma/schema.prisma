// NesilCoffee — content, media, admin and inbound-lead schema.
//
// Localized text is stored as Json shaped `{ ru, en?, tk?, uz?, az? }`.
// Only `ru` is guaranteed; every read goes through `pick()` in
// src/lib/i18n-field.ts, which falls back to `ru` and then to a
// caller-supplied default from the next-intl message files. That keeps
// the site rendering complete copy while translations are backfilled.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum SubmissionType {
  CONTACT
  ORDER
}

/// How the customer chose to send their enquiry. FORM means they used the
/// plain submit; WHATSAPP and EMAIL mean they were handed a pre-filled message
/// and continued in that app.
enum SubmissionChannel {
  FORM
  WHATSAPP
  EMAIL
}

// --------------------------------------------------------------------------
//  Media
// --------------------------------------------------------------------------

/// One uploaded (or seeded) image. `path` is a site-absolute URL: uploads
/// live at /uploads/** and are served straight off disk by nginx, while
/// seeded legacy assets keep their existing /products/** public/ paths.
/// Both forms are valid `src` values for next/image.
model Media {
  id           String   @id @default(cuid())
  path         String   @unique
  /// The filename the editor uploaded, kept verbatim. `path` is random hex, so
  /// without this two near-identical uploads are indistinguishable in the
  /// gallery — which is the whole reason it exists. Null on rows created
  /// before this column, and on seeded public/ assets.
  originalName String?
  width        Int?
  height       Int?
  /// Base64 placeholder generated by sharp at upload time. Legacy rows are
  /// seeded from the pre-generated map in src/lib/blur-data.ts.
  blurDataUrl  String?
  mimeType     String?
  bytes        Int?
  alt          Json?
  createdAt    DateTime @default(now())

  productImages     Product[]           @relation("ProductImage")
  slideOverrides    HomeSlide[]         @relation("HomeSlideImageOverride")
  heroBackgrounds   ProductsHeroSlide[] @relation("HeroSlideBackground")
  heroProductArt    ProductsHeroSlide[] @relation("HeroSlideProductArt")
  teamAvatars       TeamMember[]        @relation("TeamMemberAvatar")
  certificateImages Certificate[]       @relation("CertificateImage")
  expertPhotos      Expert[]            @relation("ExpertPhoto")
}

// --------------------------------------------------------------------------
//  Catalog
// --------------------------------------------------------------------------

model Category {
  id         String    @id @default(cuid())
  slug       String    @unique
  name       Json
  /// Per-field `required | optional | off`, keyed by the field names in
  /// src/lib/category-fields.ts. `{}` means "every field takes its default",
  /// which reproduces the behaviour that existed before this column.
  fieldRules Json      @default("{}")
  sortOrder  Int       @default(0)
  isActive   Boolean   @default(true)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  products Product[]

  @@index([sortOrder])
}

model Product {
  id   String @id @default(cuid())
  /// Reserved for future /products/[slug] detail pages. Unique from day one
  /// so adding those pages later needs no migration on populated data.
  slug String @unique

  name        Json
  /// null falls back to the shared `products.cardDescription` message.
  description Json?
  /// null falls back to the shared `home.products.tagline` message.
  tagline     Json?

  /// Display string exactly as shown ("1000 гр"), not a parsed quantity —
  /// this mirrors current behaviour where the unit is the same in every locale.
  /// For multi-pack products this is the weight of ONE unit; `pieces` carries
  /// the count, and the card composes them as "20 шт × 18 гр".
  weight  String
  /// Units per pack. Null for anything sold as a single container.
  pieces  Int?
  arabica String?
  robusta String?
  /// Nullable since category field rules landed: a tea has no roast profile
  /// and a category can switch either spec off entirely. A stored value is
  /// kept when its field is switched off, so switching back restores it.
  roast   Int?
  acidity Int?

  imageId String?
  image   Media?  @relation("ProductImage", fields: [imageId], references: [id], onDelete: SetNull)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  homeSlides  HomeSlide[]
  heroSlides  ProductsHeroSlide[]
  submissions Submission[]

  @@index([categoryId, sortOrder])
  @@index([deletedAt, isActive])
}

// --------------------------------------------------------------------------
//  Carousels
// --------------------------------------------------------------------------

/// Home-page carousel. Name, roast and acidity are read live from the linked
/// product; only the image may diverge — today's carousel deliberately shows
/// different art than the matching product card.
model HomeSlide {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  imageOverrideId String?
  imageOverride   Media?  @relation("HomeSlideImageOverride", fields: [imageOverrideId], references: [id], onDelete: SetNull)

  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

/// Full-bleed hero at the top of /products. Carries its own marketing copy
/// rather than reusing product text, plus the background tint the design
/// applies per slide.
model ProductsHeroSlide {
  id String @id @default(cuid())

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  /// Optional overrides. When empty, the slide falls back to the linked
  /// product's name and description, the same way the home carousel reads its
  /// specs live from the product — so editing a product updates both places.
  title    Json?
  body     Json?
  ctaLabel Json?

  bgImageId String?
  bgImage   Media?  @relation("HeroSlideBackground", fields: [bgImageId], references: [id], onDelete: SetNull)

  /// Empty means "use the linked product's own image".
  productImageId String?
  productImage   Media?  @relation("HeroSlideProductArt", fields: [productImageId], references: [id], onDelete: SetNull)

  /// Hex, e.g. "#245314". Rendered as an rgba overlay at `overlayOpacity`%.
  overlayColor   String @default("#1e140f")
  overlayOpacity Int    @default(65)

  /// Horizontal placement of the product image on desktop, as a percentage
  /// across the right half of the carousel: 0 = centre of the carousel, 100 =
  /// right edge. Product pack shots carry different amounts of transparent
  /// padding, so a fixed position leaves some looking off — this lets an editor
  /// slide each one. 100 reproduces the old right-aligned default.
  productOffset Int @default(100)

  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

// --------------------------------------------------------------------------
//  Page content
// --------------------------------------------------------------------------

model TeamMember {
  id   String @id @default(cuid())
  name Json
  role Json

  phone String?
  email String?

  avatarId String?
  avatar   Media?  @relation("TeamMemberAvatar", fields: [avatarId], references: [id], onDelete: SetNull)

  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([sortOrder])
}

/// The two named specialists quoted on the About page.
///
/// Deliberately a fixed pair: the design has exactly two cards side by side and
/// the admin offers no add or delete, only edit. There is no `isActive` for the
/// same reason — hiding one would leave a half-empty row. If a third is ever
/// needed it is one INSERT, not a schema change.
model Expert {
  id    String @id @default(cuid())
  name  Json
  role  Json
  /// Sanitized HTML, one entry per locale — see sanitizeRichText() in
  /// src/server/form.ts. Plain text is still valid here and renders as-is.
  quote Json

  photoId String?
  photo   Media?  @relation("ExpertPhoto", fields: [photoId], references: [id], onDelete: SetNull)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model FaqItem {
  id       String @id @default(cuid())
  question Json
  /// Sanitized HTML per locale. Rows written before the rich-text editor held
  /// plain text and were wrapped in <p> by the migration that introduced it.
  answer   Json

  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([sortOrder])
}

model Certificate {
  id          String @id @default(cuid())
  name        Json
  description Json

  imageId String?
  image   Media?  @relation("CertificateImage", fields: [imageId], references: [id], onDelete: SetNull)

  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([sortOrder])
}

/// Singleton row (id = 1) holding the contact details that are currently
/// duplicated across Footer.tsx, the contacts page and the JSON-LD block.
model Setting {
  id Int @id @default(1)

  /// Ordered list of display strings, e.g. ["+993 137 32969", "+993 137 32973"].
  phones          Json    @default("[]")
  email           String  @default("info@nesilcoffee.com")
  address         Json
  /// E.164 digits for the wa.me link that RECEIVES orders and contact-form
  /// hand-offs, e.g. "99313732969". Not necessarily the number shown on the
  /// contacts page — see `contactWhatsapp`.
  whatsapp        String?
  /// E.164 digits for the WhatsApp number DISPLAYED on the contacts page.
  /// Empty falls back to `whatsapp`, so a site with one number keeps working.
  contactWhatsapp String?
  /// Telegram handle or full t.me URL, displayed only. Normalized to a URL at
  /// render time so either form can be pasted in.
  telegram        String?
  instagram       String?
  tiktok          String?

  /// Heading above the two expert cards on the About page. Null falls back to
  /// the `about.experts.title` message.
  expertsTitle Json?

  updatedAt DateTime @updatedAt
}

// --------------------------------------------------------------------------
//  Admin
// --------------------------------------------------------------------------

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  /// argon2id
  passwordHash String
  name         String
  role         Role      @default(EDITOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions AdminSession[]
}

model AdminSession {
  id        String @id @default(cuid())
  /// SHA-256 of the session token. The raw token exists only in the cookie,
  /// so a database leak does not hand over live sessions.
  tokenHash String @unique

  userId String
  user   AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// --------------------------------------------------------------------------
//  Inbound
// --------------------------------------------------------------------------

/// Contact-form messages and order requests, persisted before any
/// notification is attempted so a failed send never loses a lead.
model Submission {
  id   String         @id @default(cuid())
  type SubmissionType

  name    String
  email   String?
  phone   String?
  subject String?
  message String?

  /// ORDER only.
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Denormalised so the log stays readable if the product is later deleted.
  productName String?
  quantity    Int?

  locale    String  @default("ru")
  ip        String?
  userAgent String?
  isSpam    Boolean @default(false)

  /// Which button the customer pressed. The row is written before the handoff,
  /// so a lead is recorded even if they never finish sending in WhatsApp.
  channel SubmissionChannel @default(FORM)

  notifiedEmail    Boolean @default(false)
  notifiedWhatsapp Boolean @default(false)
  notifyError      String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
}

/// Fixed-window per-IP counter backing the public form rate limit.
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  /// timestamptz, not plain timestamp: this column is only ever written and
  /// compared using Postgres `now()`, and an unqualified `timestamp` forces an
  /// implicit cast through the session time zone. That cast previously shifted
  /// the window by the server's UTC offset. See src/server/rate-limit.ts.
  windowEnd DateTime @db.Timestamptz(3)

  @@index([windowEnd])
}
